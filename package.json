    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-bookings": "cds watch --open my.hotelbooking.bookings/index.html?sap-ui-xx-viewCache=false --livereload false"
