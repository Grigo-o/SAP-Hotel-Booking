            "roles": [
              "Manager"
            ]
          },
          "saba": {
            "password": "saba",
            "roles": [
              "Customer"
            ],
            "attr": {
              "email": "saba.grigolia@example.com"
            }
          },
          "john": {
            "password": "john",
            "roles": [
              "Customer"
            ],
            "attr": {
              "email": "john.smith@example.com"
            }
          }
        }
      }
    }
  },
